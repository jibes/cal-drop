# Build-time defaults for the deployed site. Non-secret by definition: every
# value here is inlined into the public JS bundle, so never put a key in it.
#
# A repository variable of the same name overrides whatever is set here, so
# these are defaults, not a lock.

# The shared endpoint (worker/), which answers the browser's CORS preflight
# and keeps the upstream key server-side.
VITE_PROXY_URL=https://caldrop-endpoint.sebastian-9fc.workers.dev/v1

# Must be one of the worker's ALLOWED_MODELS.
VITE_AI_MODEL=gemma-4-31b
