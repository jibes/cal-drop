# The endpoint the app talks to — a deployment of worker/, which holds the
# upstream key, picks the model, reads event links, and checks the access code.
#
# This value ends up in the public bundle. That is fine: it is a URL, not a
# secret. The access code is never built in; each person enters it once.
VITE_PROXY_URL=https://your-worker.workers.dev/v1
