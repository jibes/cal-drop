# Non-secret build-time defaults. These are inlined into the public JS bundle,
# so NEVER put an API key here for a public deployment — the app asks the user
# for their key at runtime and stores it locally on their device.

# Default OpenAI-compatible endpoint (chat completions base URL, no trailing /v1 path)
VITE_AI_BASE_URL=https://api.openai.com/v1

# Default model. Must support image input for photos/screenshots.
VITE_AI_MODEL=gpt-4o-mini

# Optional: a separate text-only model used for URL/plain-text extraction.
VITE_AI_TEXT_MODEL=

# Optional: CORS proxy template used to fetch event links from the browser.
# {url} is replaced with the encoded target URL.
VITE_CORS_PROXY=https://r.jina.ai/{url}

# Optional: pre-fill the key field for LOCAL development only (never commit).
# VITE_AI_API_KEY=
